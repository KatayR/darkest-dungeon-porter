+#else
+// glibc's glob_t layout and GLOB_* values differ from bionic's: run bionic glob, then hand the
+// guest its own copy of the result in glibc layout.
+typedef struct glibc_glob_s {
+    size_t gl_pathc;
+    char** gl_pathv;
+    size_t gl_offs;
+    int gl_flags;
+    void* gl_funcs[5];
