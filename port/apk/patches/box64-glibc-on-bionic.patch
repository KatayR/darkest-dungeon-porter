+    for(int c=-128; c<256; ++c) {
+        unsigned short f = 0;
+        if(c>=0 && c<128) {
+            if(isupper(c)) f |= G_UPPER;
+            if(islower(c)) f |= G_LOWER;
+            if(isalpha(c)) f |= G_ALPHA;
+            if(isdigit(c)) f |= G_DIGIT;
+            if(isxdigit(c)) f |= G_XDIGIT;
+            if(isspace(c)) f |= G_SPACE;
+            if(isprint(c)) f |= G_PRINT;
+            if(isgraph(c)) f |= G_GRAPH;
+            if(isblank(c)) f |= G_BLANK;
+            if(iscntrl(c)) f |= G_CNTRL;
+            if(ispunct(c)) f |= G_PUNCT;
