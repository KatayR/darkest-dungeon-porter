+#ifdef ANDROID
+// bionic has no thread cancellation: report the glibc defaults (enabled, deferred) and never cancel
+EXPORT int my_pthread_setcancelstate(x64emu_t* emu, int state, int* oldstate)
+{
+    (void)emu; (void)state;
+    if(oldstate) *oldstate = 0;
+    return 0;
+}
+EXPORT int my_pthread_setcanceltype(x64emu_t* emu, int type, int* oldtype)
+{
+    (void)emu; (void)type;
+    if(oldtype) *oldtype = 0;
+    return 0;
+}
+EXPORT void my_pthread_testcancel(x64emu_t* emu) { (void)emu; }
+EXPORT int my_pthread_cancel(x64emu_t* emu, uintptr_t thread)
+{
+    (void)emu; (void)thread;
+    printf_log(LOG_INFO, "Warning, pthread_cancel is not supported on Android, ignored\n");
+    return ENOSYS;
+}
+#endif
+
