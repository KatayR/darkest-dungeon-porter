diff --git a/src/glx/android_glx.c b/src/glx/android_glx.c
new file mode 100644
index 00000000..67d89357
--- /dev/null
+++ b/src/glx/android_glx.c
@@ -0,0 +1,23 @@
+// Minimal GLX entry points for Android builds (NOX11): the context comes from the app (EGL via SDL),
+// but desktop-GL programs (e.g. run through box64) still look up functions with glXGetProcAddress
+// and may ask for the GLX version.
+#include "gl4esinit.h"
+
+typedef int Bool;
+
+__attribute__((visibility("default"))) void* glXGetProcAddress(const char* name) {
+    return gl4es_GetProcAddress(name);
+}
+__attribute__((visibility("default"))) void* glXGetProcAddressARB(const char* name) {
+    return gl4es_GetProcAddress(name);
+}
+__attribute__((visibility("default"))) Bool glXQueryVersion(void* display, int* major, int* minor) {
+    (void)display;
+    if(major) *major = 1;
+    if(minor) *minor = 4;
+    return 1;
+}
+__attribute__((visibility("default"))) const char* glXGetClientString(void* display, int name) {
+    (void)display; (void)name;
+    return "gl4es";
+}
