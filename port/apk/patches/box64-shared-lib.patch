diff --git a/src/main.c b/src/main.c
index a91825c4b..6bd59dee7 100644
--- a/src/main.c
+++ b/src/main.c
@@ -1,7 +1,29 @@
 // SPDX-License-Identifier: MIT
+#include <stdlib.h>
+#include <string.h>
 #include "core.h"
+#include "debug.h"
 
+#ifdef BOX64_SHARED
+// Entry point when box64 is a shared library loaded into another process (e.g. an Android app):
+// argv[0] stands for box64 itself, argv[1] is the x86_64 program to run.
+EXPORT int box64_run(int argc, const char **argv, char **env) {
+    // initialize() shifts the argv strings in place, as if they were this process' own contiguous
+    // argv: give it a writable copy laid out that way
+    size_t size = 0;
+    for (int i = 0; i < argc; ++i)
+        size += strlen(argv[i]) + 1;
+    char* strings = calloc(1, size);
+    const char** args = calloc(argc + 1, sizeof(char*));
+    char* p = strings;
+    for (int i = 0; i < argc; ++i) {
+        args[i] = strcpy(p, argv[i]);
+        p += strlen(argv[i]) + 1;
+    }
+    argv = args;
+#else
 int main(int argc, const char **argv, char **env) {
+#endif
 
     x64emu_t* emu = NULL;
     elfheader_t* elf_header = NULL;
