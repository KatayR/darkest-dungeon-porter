# Repo tracks only the Android port work; the game install itself is never committed.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/port/
!/notes/
# Gradle state (builds run from a copy under C:\dd-build, see port/apk/build-apk.sh)
port/apk/.gradle/
port/apk/local.properties
# zips made by running port/steam/get-steam-game.bat or port/saves/get-saves.bat in place
port/steam/*.zip
port/saves/*.zip
